# 将此文件内容复制到项目根目录的 .env 后再运行测试。
# Copy these values into a .env file at the project root before running tests.
#
# 测试命令：
# Test commands:
# - composer test:unit
# - composer test:integration
# - composer test:functional
#
# 单元测试不依赖这些变量；
# 集成测试至少需要 LARK_TEST_APP_ID、LARK_TEST_APP_SECRET；
# 功能调试脚本可额外使用 LARK_TEST_ACCESS_TOKEN。
# Unit tests do not require these variables;
# integration tests require at least LARK_TEST_APP_ID and LARK_TEST_APP_SECRET;
# the functional helper script can additionally use LARK_TEST_ACCESS_TOKEN.

# 集成测试、功能测试使用的应用凭证。
# App credentials for integration and functional tests.
# 运行需要应用鉴权的测试时必须填写。
# Required for tests that need app authentication.
LARK_TEST_APP_ID=cli_test_app_id
LARK_TEST_APP_SECRET=test_app_secret

# 可选访问令牌。
# Optional access token.
# 执行 tests/Functional/api_call.php 时，如果没有显式传入 access_token 参数，则使用这里的值。
# Used by tests/Functional/api_call.php when no access_token argument is passed explicitly.
LARK_TEST_ACCESS_TOKEN=test_access_token

# 常用测试资源 ID。
# Common resource IDs for integration tests.
# 下面这些值在编写真实接口测试时会直接使用。
# These values are used directly by real integration tests.

# 用户 ID。
# User ID.
# 通常为 user_id，例如 ou_xxx。
# Usually a user_id such as ou_xxx.
LARK_TEST_USER_ID=ou_test_user_id

# Open ID。
# Open ID.
# 用于需要 open_id 的接口，例如发送消息。
# Used by APIs that require open_id, such as sending messages.
LARK_TEST_OPEN_ID=ou_test_open_id

# 用户邮箱。
# User email.
# 用于通过邮箱查用户 ID 等接口。
# Used by APIs such as looking up user IDs by email.
LARK_TEST_EMAIL=test@example.com

# 用户手机号。
# User mobile number.
# 用于通过手机号查用户 ID 等接口。
# Used by APIs such as looking up user IDs by mobile number.
LARK_TEST_MOBILE=13800000000

# 部门 ID。
# Department ID.
# 用于部门、用户列表等通讯录接口；需要应用具备对应部门权限。
# Used by directory APIs such as department and user list endpoints; the app must have access to the department.
LARK_TEST_DEPARTMENT_ID=0

# 群聊 ID。
# Chat ID.
# 用于 IM 群聊、消息等接口。
# Used by IM chat and message APIs.
LARK_TEST_CHAT_ID=oc_test_chat_id

# 消息 ID。
# Message ID.
# 用于消息详情、已读用户、表情回复等接口。
# Used by APIs such as message details, read users, and reactions.
LARK_TEST_MESSAGE_ID=om_test_message_id

# 日历 ID。
# Calendar ID.
# 用于日历和日程相关接口。
# Used by calendar and event APIs.
LARK_TEST_CALENDAR_ID=cal_test_calendar_id

# 云文档文件 token。
# Drive file token.
# 用于云空间文件、权限等接口。
# Used by Drive file and permission APIs.
LARK_TEST_FILE_TOKEN=file_test_token

# 多维表格 / 电子表格 token。
# Sheet token.
# 用于 Sheets 接口。
# Used by Sheets APIs.
LARK_TEST_SHEET_TOKEN=sht_test_token

# 文档 token。
# Doc token.
# 用于 Docs / Docx 相关接口。
# Used by Docs / Docx APIs.
LARK_TEST_DOC_TOKEN=doc_test_token

# Wiki 节点 token。
# Wiki node token.
# 用于知识库节点相关接口。
# Used by Wiki node APIs.
LARK_TEST_WIKI_NODE_TOKEN=wikcn_test_node

# 飞书开放平台接口基础地址。
# Base URL for Feishu Open Platform APIs.
# 除非需要接入自定义网关，否则保持默认值即可。
# Keep the default unless you need a custom gateway endpoint.
LARK_TEST_BASE_URI=https://open.feishu.cn

# 测试请求使用的 User-Agent。
# User-Agent for test requests.
LARK_TEST_USER_AGENT=lark-sdk-php/test

# 事件订阅回调使用的 Verification Token。
# Verification Token for event subscription callbacks.
LARK_TEST_VERIFICATION_TOKEN=test_verification_token

# 事件订阅回调使用的 Encrypt Key。
# Encrypt Key for event subscription callbacks.
LARK_TEST_ENCRYPT_KEY=test_encrypt_key
