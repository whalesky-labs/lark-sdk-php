# 将此文件内容复制到项目根目录的 .env 后再运行测试。
# Copy these values into a .env file at the project root before running tests.
#
# 测试命令：
# Test commands:
# - composer test:unit
# - composer test:integration
# - composer test:functional
#
# 单元测试不依赖这些变量；
# 集成测试至少需要 LARK_TEST_APP_ID、LARK_TEST_APP_SECRET；
# 功能调试脚本可额外使用 LARK_TEST_ACCESS_TOKEN。
# Unit tests do not require these variables;
# integration tests require at least LARK_TEST_APP_ID and LARK_TEST_APP_SECRET;
# the functional helper script can additionally use LARK_TEST_ACCESS_TOKEN.

# 集成测试、功能测试使用的应用凭证。
# App credentials for integration and functional tests.
# 运行需要应用鉴权的测试时必须填写。
# Required for tests that need app authentication.
LARK_TEST_APP_ID=cli_test_app_id
LARK_TEST_APP_SECRET=test_app_secret

# 可选访问令牌。
# Optional access token.
# 执行 tests/Functional/api_call.php 时，如果没有显式传入 access_token 参数，则使用这里的值。
# Used by tests/Functional/api_call.php when no access_token argument is passed explicitly.
LARK_TEST_ACCESS_TOKEN=test_access_token

# 飞书开放平台接口基础地址。
# Base URL for Feishu Open Platform APIs.
# 除非需要接入自定义网关，否则保持默认值即可。
# Keep the default unless you need a custom gateway endpoint.
LARK_TEST_BASE_URI=https://open.feishu.cn

# 测试请求使用的 User-Agent。
# User-Agent for test requests.
LARK_TEST_USER_AGENT=lark-sdk-php/test

# 事件订阅回调使用的 Verification Token。
# Verification Token for event subscription callbacks.
LARK_TEST_VERIFICATION_TOKEN=test_verification_token

# 事件订阅回调使用的 Encrypt Key。
# Encrypt Key for event subscription callbacks.
LARK_TEST_ENCRYPT_KEY=test_encrypt_key
